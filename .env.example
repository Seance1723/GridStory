GRIDSTORY_HOST=127.0.0.1
GRIDSTORY_PORT=4000
GRIDSTORY_DATABASE_PATH=.gridstory/gridstory.db
# Use this instead of GRIDSTORY_DATABASE_PATH for the production PostgreSQL adapter.
# GRIDSTORY_DATABASE_URL=postgresql://gridstory:gridstory@localhost:5432/gridstory
GRIDSTORY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Local development accepts the Studio actor header. Production rejects it and requires a
# backend-verified opaque cookie/bearer session. See docs/identity-and-access.md before enabling.
GRIDSTORY_IDENTITY_MODE=development
GRIDSTORY_IDENTITY_COOKIE_NAME=gridstory_session
# Secure defaults to true in production. Set false only for isolated HTTP localhost testing.
# GRIDSTORY_IDENTITY_SECURE_COOKIES=true
# Inject this JSON from a protected runtime/secret manager; never commit client secrets or certs.
# GRIDSTORY_FEDERATION_PROVIDERS_JSON=[{"id":"workforce","protocol":"oidc","issuer":"https://identity.example.com","clientId":"gridstory","clientSecret":"injected","redirectUri":"https://cms.example.com/api/v1/identity/federation/workforce/callback?organizationId=acme&tenantId=main","groupClaim":"groups"}]
GRIDSTORY_WEBAUTHN_RP_NAME=GridStory
GRIDSTORY_WEBAUTHN_RP_ID=localhost
GRIDSTORY_WEBAUTHN_ORIGINS=http://localhost:5173
# Replace this with a long random value in every shared or production environment.
GRIDSTORY_CURSOR_SECRET=gridstory-local-cursor-secret-change-me
# Preview grants use a distinct secret and an exact application-origin allow-list.
GRIDSTORY_PREVIEW_SIGNING_SECRET=gridstory-local-preview-signing-secret-change-me
GRIDSTORY_PREVIEW_ALLOWED_ORIGINS=http://localhost:5174
# Private asset delivery grants use a distinct HMAC secret; object storage must remain private.
GRIDSTORY_ASSET_DELIVERY_SIGNING_SECRET=gridstory-local-asset-delivery-secret-change-me
VITE_GRIDSTORY_PREVIEW_URL=http://localhost:5174/
VITE_GRIDSTORY_STUDIO_ORIGIN=http://localhost:5173
# JSON array; each site needs exactly one enabled default locale and acyclic fallbacks.
# GRIDSTORY_LOCALES_JSON=[{"code":"en","siteId":"default","label":"English","default":true,"enabled":true,"required":true,"routePrefix":""},{"code":"fr","siteId":"default","label":"French","default":false,"enabled":true,"required":true,"fallbackLocales":["en"],"routePrefix":"/fr"}]
# Replace this before enabling webhooks. Receivers verify HMAC-SHA256 signatures with it.
GRIDSTORY_WEBHOOK_SIGNING_SECRET=gridstory-local-webhook-signing-secret-change-me
# Optional comma-separated HTTPS host allow-list, strongly recommended in production.
# GRIDSTORY_WEBHOOK_ALLOWED_HOSTS=hooks.example.com,automation.example.com
GRIDSTORY_WORKER_INTERVAL_MS=1000
# Runtime storage/KMS placement attestation only; this does not route data between regions.
GRIDSTORY_DATA_REGIONS=local
# Must remain shorter than the deployment platform's termination grace period.
GRIDSTORY_SHUTDOWN_TIMEOUT_MS=25000
# OpenTelemetry is opt-in. OTLP/HTTP exporters honor the standard OTEL_EXPORTER_OTLP_* variables.
GRIDSTORY_OTEL_ENABLED=false
OTEL_SERVICE_NAME=gridstory-api
# Set a release/build identifier without spaces when one is available.
# GRIDSTORY_SERVICE_VERSION=2026.08.21
# The generic endpoint appends /v1/traces, /v1/metrics, and /v1/logs automatically.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
OTEL_METRIC_EXPORT_INTERVAL=60000
# Optional private Collector health_check extension; never put credentials in this URL.
# GRIDSTORY_OTEL_HEALTHCHECK_URL=http://127.0.0.1:13133/
GRIDSTORY_OTEL_HEALTH_TIMEOUT_MS=2000
VITE_GRIDSTORY_API_URL=http://localhost:4000
VITE_GRIDSTORY_TENANT=default
# Set to production with GRIDSTORY_IDENTITY_MODE so Studio uses the secure session cookie and
# stops sending the development actor header.
VITE_GRIDSTORY_IDENTITY_MODE=development

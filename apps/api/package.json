{
  "name": "@gridstory/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "recovery": "node dist/recovery-cli.js",
    "rollout:check": "node dist/rolling-upgrade-cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:recovery": "vitest run test/database-recovery.test.ts test/graceful-shutdown.test.ts test/worker-loop.test.ts test/rolling-upgrade.test.ts",
    "test:postgres": "vitest run test/postgres-server.test.ts",
    "typecheck": "pnpm --filter @gridstory/schema build && pnpm --filter @gridstory/core build && pnpm --filter @gridstory/example-kit build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/formbody": "9.0.1",
    "@gridstory/core": "workspace:*",
    "@gridstory/example-kit": "workspace:*",
    "@gridstory/schema": "workspace:*",
    "@node-saml/node-saml": "5.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7",
    "graphql": "17.0.2",
    "mercurius": "16.12.0",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "tsx": "4.23.1"
  }
}

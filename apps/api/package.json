{
  "name": "@gridstory/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:postgres": "vitest run test/postgres-server.test.ts",
    "typecheck": "pnpm --filter @gridstory/schema build && pnpm --filter @gridstory/core build && pnpm --filter @gridstory/example-kit build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@gridstory/core": "workspace:*",
    "@gridstory/example-kit": "workspace:*",
    "@gridstory/schema": "workspace:*",
    "fastify": "5.10.0",
    "graphql": "16.11.0",
    "mercurius": "16.10.0"
  },
  "devDependencies": {
    "tsx": "4.23.1"
  }
}

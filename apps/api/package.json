{
  "name": "@gridstory/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "recovery": "node dist/recovery-cli.js",
    "rollout:check": "node dist/rolling-upgrade-cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:recovery": "vitest run test/database-recovery.test.ts test/graceful-shutdown.test.ts test/worker-loop.test.ts test/rolling-upgrade.test.ts",
    "test:postgres": "vitest run test/postgres-server.test.ts",
    "typecheck": "pnpm --filter @gridstory/schema build && pnpm --filter @gridstory/core build && pnpm --filter @gridstory/example-kit build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "9.0.0",
    "@gridstory/core": "workspace:*",
    "@gridstory/example-kit": "workspace:*",
    "@gridstory/schema": "workspace:*",
    "@node-saml/node-saml": "5.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@simplewebauthn/server": "13.3.2",
    "fastify": "5.12.1",
    "graphql": "17.0.2",
    "mercurius": "16.10.0",
    "openid-client": "6.8.7"
  },
  "devDependencies": {
    "tsx": "4.23.1"
  }
}

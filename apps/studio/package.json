{
  "name": "@gridstory/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:e2e": "tsc -p tsconfig.json --noEmit && vite build --mode e2e",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "pnpm --filter @gridstory/schema build && pnpm --filter @gridstory/client build && pnpm --filter @gridstory/react build && pnpm --filter @gridstory/example-kit build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gridstory/client": "workspace:*",
    "@gridstory/example-kit": "workspace:*",
    "@gridstory/react": "workspace:*",
    "@gridstory/schema": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "sass": "1.105.2",
    "vite": "8.3.4"
  }
}

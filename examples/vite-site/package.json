{
  "name": "@gridstory/example-vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:e2e": "tsc -p tsconfig.json --noEmit && vite build --mode e2e",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gridstory/client": "workspace:*",
    "@gridstory/example-kit": "workspace:*",
    "@gridstory/react": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2"
  }
}

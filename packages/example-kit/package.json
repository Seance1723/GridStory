{
  "name": "@gridstory/example-kit",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./manifests": {
      "types": "./dist/manifests.d.ts",
      "default": "./dist/manifests.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./generated": {
      "types": "./dist/generated.d.ts",
      "default": "./dist/generated.js"
    },
    "./design-system": {
      "types": "./dist/design-system.d.ts",
      "default": "./dist/design-system.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gridstory/react": "workspace:*",
    "@gridstory/schema": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20.0.0"
  },
  "devDependencies": {
    "react": "19.2.7"
  }
}

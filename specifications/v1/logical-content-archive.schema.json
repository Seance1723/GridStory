{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "manifest"
        },
        "format": {
          "type": "string",
          "const": "gridstory.logical-content"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "sourceScope": {
          "type": "object",
          "properties": {
            "organizationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "tenantId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "siteId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "environmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "locale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "organizationId",
            "tenantId",
            "workspaceId",
            "siteId",
            "environmentId",
            "locale"
          ],
          "additionalProperties": false
        },
        "exportedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "entryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "archiveChecksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schemaFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "format",
        "version",
        "sourceScope",
        "exportedAt",
        "entryCount",
        "archiveChecksum"
      ],
      "additionalProperties": false
    },
    "entries": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "entry"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "record": {
            "type": "object",
            "properties": {
              "entryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "contentType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "currentDraftRevisionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "publishedRevisionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "translationGroupId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "revisions": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "sequence": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "baseRevisionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "actorId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "data": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    }
                  },
                  "required": [
                    "id",
                    "sequence",
                    "actorId",
                    "data",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              },
              "auditEvents": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "sequence": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "actorId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "content.created",
                        "content.draft.updated",
                        "content.published"
                      ]
                    },
                    "revisionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "occurredAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    }
                  },
                  "required": [
                    "id",
                    "sequence",
                    "actorId",
                    "action",
                    "revisionId",
                    "occurredAt"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "entryId",
              "contentType",
              "currentDraftRevisionId",
              "translationGroupId",
              "createdAt",
              "updatedAt",
              "revisions",
              "auditEvents"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "checksum",
          "record"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "manifest",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "urn:gridstory:spec:logical-content-archive:1",
  "title": "GridStory logical-content-archive v1"
}

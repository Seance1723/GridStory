{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "gridstory.preview-source-map"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "entry": {
      "type": "object",
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revisionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "entryId",
        "contentType"
      ],
      "additionalProperties": false
    },
    "mappings": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "componentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "componentVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "selector": {
            "type": "object",
            "properties": {
              "attribute": {
                "type": "string",
                "const": "data-gridstory-node"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "attribute",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "nodeId",
          "componentId",
          "componentVersion",
          "selector"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "entry",
    "mappings"
  ],
  "additionalProperties": false,
  "$id": "urn:gridstory:spec:preview-source-map:1",
  "title": "GridStory preview-source-map v1"
}
